---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Icon from '~/components/Icon.astro';
import siteConfig from '~/config/site';
import { graph, breadcrumbSchema, personSchema } from '~/lib/jsonld';
import { freeResourcesDossier } from '~/data/freeResources';

const pageUrl = `${siteConfig.url}/free/`;

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: '首页', url: `${siteConfig.url}/` },
    { name: '免费资源避坑矩阵', url: pageUrl },
  ]),
  {
    '@type': 'Article',
    headline: freeResourcesDossier.pageH1,
    description: freeResourcesDossier.seoDescription,
    url: pageUrl,
    inLanguage: 'zh-CN',
    author: { '@type': 'Person', name: '梯子Blog 评测实验室' },
    datePublished: '2026-10-15',
    dateModified: freeResourcesDossier.lastUpdated,
  },
  {
    '@type': 'FAQPage',
    mainEntity: freeResourcesDossier.faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  },
]);
---

<BaseLayout
  title={freeResourcesDossier.seoTitle}
  description={freeResourcesDossier.seoDescription}
  jsonLd={jsonLd}
  appendSiteName={false}
>
  <article>
    <!-- Page Hero Header -->
    <header class="wrap phero">
      <div class="phero-in rev">
        <Breadcrumbs
          items={[
            { label: '首页', href: '/' },
            { label: '免费资源与白嫖避坑全景矩阵' },
          ]}
        />

        <div class="free-hero-head">
          <div class="free-title-line">
            <span class="pill-badge">深度专题</span>
            <h1 class="d1 free-h1">免费翻墙节点与白嫖避坑全景矩阵</h1>
            <span class="pill-tag">万字专著级技术实测</span>
            <span class="pill-tag-alt">2026年第4季度核验</span>
          </div>

          <div class="free-hero-actions">
            <a href="#cf-workers-tutorial" class="btn btn-outline btn-md">
              <span>跳转 CF Workers 搭建教程</span>
            </a>
            <a href="/brands/guangsu/" class="btn btn-lime btn-md">
              <span>查阅 2.4元/月买断专线方案</span>
              <Icon name="arrow" class="ic-xs" />
            </a>
          </div>
        </div>

        <p class="free-lead-desc">
          汇聚全网真实可用的合规免费翻墙资源、GitHub 每日自动化公共订阅与 Cloudflare Workers 零成本搭建实操。深度解密免费代理背后关于<strong>中间人凭据窃取、DNS 劫持、IP 黑化导致大模型封号与晚高峰极端断流</strong>的五大底层陷阱，并为轻度用户提供极低边际成本的无忧专线替代方案。
        </p>

        <!-- Tech Badges -->
        <div class="spec-badges">
          <div class="spec-pill">
            <span class="lbl">收录资源</span>
            <strong>CF Workers + GitHub公共源 + 官方试用</strong>
          </div>
          <div class="spec-pill">
            <span class="lbl">安全评级</span>
            <strong>高危注意防护（附沙盒与防泄漏规范）</strong>
          </div>
          <div class="spec-pill">
            <span class="lbl">技术支持协议</span>
            <strong>VLESS / Trojan / Shadowsocks / WARP+</strong>
          </div>
          <div class="spec-pill">
            <span class="lbl">核验周期</span>
            <strong>2026年11月实时更新</strong>
          </div>
        </div>
      </div>
    </header>

    <div class="wrap sec" style="padding-top:0">
      <div class="brand-content-grid">
        <!-- Main Column -->
        <div class="brand-main-col">
          <div class="monograph-container">
            {freeResourcesDossier.chapters.map((chapter) => (
              <section class="card-section rev monograph-section" id={chapter.anchor}>
                <div class="section-title-wrap">
                  <h2 class="d3 mono-chapter-title">{chapter.title}</h2>
                  {chapter.badge && <span class="badge-measured">{chapter.badge}</span>}
                </div>
                <p class="section-sub mono-summary">{chapter.summary}</p>
                <div class="mono-content-body" set:html={chapter.contentHtml} />
              </section>
            ))}
          </div>
        </div>

        <!-- Sidebar Sticky Column -->
        <aside class="brand-sidebar-col rev rev-d2">
          <!-- Table of Contents -->
          <div class="sidebar-card nav-card sticky-toc-card">
            <h4 class="nav-title">📖 本专著全书目录</h4>
            <ul class="quick-nav-list monograph-toc">
              {freeResourcesDossier.chapters.map((ch, idx) => (
                <li>
                  <a href={`#${ch.anchor}`} class="toc-link">
                    <span class="toc-num">{idx + 1}.</span>
                    <span class="toc-txt">{ch.navTitle}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Conversion / Low-Cost Promo Card -->
          <div class="sidebar-card promo-card">
            <h3 class="sc-title">💡 厌倦找免费节点的精神内耗？</h3>
            <p class="sc-desc">
              轻度查资料科研党首选：一次性买断 <strong>光速云 147 永久套餐</strong>，247GB 企业级双线专线流量永不过期，平均摊薄每月仅 <strong>2.4 元</strong>，支持全平台一键客户端，彻底摆脱断流与被封号的折磨。
            </p>
            <div class="sc-btn-wrap">
              <a href="/brands/guangsu/" class="btn btn-lime btn-full">
                <span>查阅光速云万字评测报告</span>
                <Icon name="arrow" class="ic-xs" />
              </a>
              <p class="sc-disclaimer">
                * 结账输入优惠码 <code>AMM</code> 享折上立减优惠
              </p>
            </div>
          </div>

          <!-- Related Hub Guides Card -->
          <div class="sidebar-card guides-nav-card">
            <h4 class="nav-title">核心攻略与决策中心</h4>
            <ul class="quick-nav-list">
              <li><a href="/brands/">🌐 42 家机场品牌横评库</a></li>
              <li><a href="/speedtest/">⚡ 全网千兆晚高峰测速榜</a></li>
              <li><a href="/clients/">📱 多平台客户端配置中心</a></li>
              <li><a href="/guides/decision-tree/">🎯 2026 选型决策树</a></li>
              <li><a href="/guides/airport-anti-scam/">🛡️ 新手避坑防跑路法则</a></li>
              <li><a href="/guides/chatgpt-streaming-unlock/">🎬 ChatGPT与流媒体解锁内幕</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .free-hero-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    flex-wrap: wrap;
    margin: 16px 0 20px;
  }

  .free-title-line {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .pill-badge {
    background: #0b6cb2;
    color: #ffffff;
    padding: 4px 12px;
    border-radius: var(--r-pill);
    font-size: 13px;
    font-weight: 700;
  }

  .pill-tag {
    background: var(--theme-accent);
    color: var(--theme-ink);
    padding: 4px 12px;
    border-radius: var(--r-pill);
    font-size: 13px;
    font-weight: 700;
  }

  .pill-tag-alt {
    background: var(--theme-mist);
    border: 1px solid var(--theme-line);
    color: var(--theme-slate);
    padding: 4px 12px;
    border-radius: var(--r-pill);
    font-size: 13px;
    font-weight: 600;
  }

  .free-h1 {
    font-size: clamp(32px, 5.2vw, 56px);
    margin: 0;
    line-height: 1.1;
    text-wrap: balance;
    word-break: keep-all;
  }

  .free-hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .free-lead-desc {
    font-size: 17px;
    line-height: 1.7;
    color: var(--theme-slate);
    max-width: 82ch;
    margin: 0 0 24px;
  }

  .spec-badges {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .spec-pill {
    background: var(--theme-mist);
    border: 1px solid var(--theme-line);
    padding: 8px 16px;
    border-radius: var(--r-sm);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .spec-pill .lbl {
    font-size: 11.5px;
    color: var(--theme-slate);
  }

  .spec-pill strong {
    font-size: 14px;
    color: var(--theme-ink);
  }

  .brand-content-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 40px;
    margin-top: 20px;
  }

  @media (max-width: 1000px) {
    .brand-content-grid {
      grid-template-columns: 1fr;
    }
  }

  .card-section {
    background: #ffffff;
    border: 1px solid var(--theme-line);
    border-radius: var(--r-md);
    padding: 32px;
    margin-bottom: 32px;
  }

  .monograph-section {
    scroll-margin-top: 80px;
  }

  .section-title-wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .mono-chapter-title {
    font-size: clamp(20px, 2.8vw, 28px);
    margin: 0;
    line-height: 1.25;
  }

  .badge-measured {
    background: #e1f7e4;
    color: #1b6325;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--r-pill);
  }

  .mono-summary {
    font-size: 15px;
    color: var(--theme-slate);
    margin: 6px 0 24px;
    padding-bottom: 14px;
    border-bottom: 1px dashed var(--theme-line);
  }

  .mono-content-body {
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--theme-ink);
  }

  .mono-content-body p {
    margin: 0 0 18px;
  }

  .mono-content-body ul, .mono-content-body ol {
    margin: 0 0 20px;
    padding-left: 24px;
  }

  .mono-content-body li {
    margin-bottom: 8px;
    line-height: 1.7;
  }

  .verdict-lead-box {
    background: var(--theme-mist);
    border: 1.5px solid var(--theme-line);
    border-radius: var(--r-md);
    padding: 24px;
    margin-bottom: 24px;
  }

  .vlb-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .vlb-tag {
    background: var(--theme-accent);
    color: var(--theme-ink);
    font-weight: 700;
    font-size: 13px;
    padding: 3px 10px;
    border-radius: var(--r-pill);
  }

  .vlb-date {
    font-size: 12px;
    color: var(--theme-slate);
  }

  .vlb-text {
    font-size: 16px;
    line-height: 1.7;
    margin-bottom: 20px !important;
  }

  .vlb-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  @media (max-width: 768px) {
    .vlb-grid {
      grid-template-columns: 1fr;
    }
  }

  .vlb-card {
    padding: 18px 20px;
    border-radius: var(--r-sm);
    border: 1px solid var(--theme-line);
  }

  .vlb-pros {
    background: #f4fbf5;
    border-color: #c7edd0;
  }

  .vlb-cons {
    background: #fcf6f6;
    border-color: #f7d7d7;
  }

  .vlb-card h4 {
    font-size: 15px;
    margin: 0 0 12px;
  }

  .vlb-card ul {
    padding-left: 18px;
    margin: 0;
  }

  .vlb-card li {
    font-size: 13.5px;
    line-height: 1.6;
    margin-bottom: 8px;
  }

  .trap-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin: 20px 0;
  }

  .trap-card {
    background: #fcf6f6;
    border: 1px solid #f7d7d7;
    border-radius: var(--r-sm);
    padding: 20px;
  }

  .trap-card .tc-icon {
    font-size: 26px;
    margin-bottom: 8px;
  }

  .trap-card h4 {
    font-size: 15.5px;
    margin: 0 0 10px;
    color: #cf1322;
  }

  .trap-card p {
    font-size: 13.5px;
    line-height: 1.6;
    color: #4b5563;
    margin: 0;
  }

  .guide-box {
    background: #ffffff;
    border: 1px solid var(--theme-line);
    border-radius: var(--r-sm);
    padding: 20px;
    margin: 18px 0;
  }

  .guide-box h4 {
    font-size: 15.5px;
    margin: 0 0 12px;
  }

  .formula-box {
    background: #fafafa;
    border: 1px solid var(--theme-line);
    border-radius: var(--r-sm);
    padding: 18px 20px;
    margin: 18px 0;
  }

  .fb-title {
    font-weight: 700;
    font-size: 14.5px;
    color: var(--theme-ink);
    margin-bottom: 10px;
  }

  .table-responsive {
    overflow-x: auto;
    margin: 16px 0;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .data-table th,
  .data-table td {
    padding: 12px 16px;
    text-align: left;
    border-bottom: 1px solid var(--theme-line);
  }

  .data-table th {
    background: var(--theme-mist);
    font-weight: 600;
    color: var(--theme-slate);
  }

  .decision-persona-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin: 20px 0;
  }

  @media (max-width: 768px) {
    .decision-persona-grid {
      grid-template-columns: 1fr;
    }
  }

  .dpg-card {
    background: var(--theme-mist);
    border: 1px solid var(--theme-line);
    border-radius: var(--r-sm);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .dpg-role {
    font-weight: 700;
    font-size: 15px;
    color: var(--theme-ink);
  }

  .dpg-profile {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--theme-slate);
  }

  .dpg-solution {
    font-size: 14px;
    background: #ffffff;
    padding: 8px 12px;
    border-radius: 4px;
    border: 1px solid var(--theme-line);
  }

  .dpg-why {
    font-size: 13px;
    line-height: 1.55;
    color: var(--theme-slate);
  }

  .privacy-tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin: 20px 0;
  }

  .pt-card {
    background: #ffffff;
    border: 1px solid var(--theme-line);
    border-radius: var(--r-sm);
    padding: 18px;
  }

  .pt-badge {
    background: var(--theme-mist);
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11.5px;
    color: var(--theme-slate);
    font-weight: 600;
    margin-bottom: 6px;
    display: inline-block;
  }

  .pt-head h4 {
    font-size: 15.5px;
    margin: 0 0 10px;
  }

  .pt-body p {
    font-size: 13px;
    line-height: 1.6;
    color: #4b5563;
    margin: 0 0 8px;
  }

  .pt-body p:last-child {
    margin: 0;
  }

  .code-block-wrap {
    background: #141715;
    color: #e5e7eb;
    border-radius: var(--r-sm);
    padding: 16px;
    margin: 14px 0;
    border: 1px solid #282f2a;
  }

  .cbw-header {
    font-size: 12.5px;
    color: var(--theme-accent);
    font-weight: 700;
    margin-bottom: 8px;
  }

  .code-block-wrap pre {
    margin: 0;
    overflow-x: auto;
  }

  .code-block-wrap code {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    line-height: 1.6;
  }

  .monograph-faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 18px 0;
  }

  .mfaq-item {
    border: 1px solid var(--theme-line);
    border-radius: var(--r-sm);
    overflow: hidden;
  }

  .mfaq-q {
    padding: 16px 20px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--theme-mist);
    user-select: none;
  }

  .mfaq-icon {
    background: var(--theme-ink);
    color: #ffffff;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 800;
  }

  .mfaq-title {
    font-size: 15px;
    color: var(--theme-ink);
  }

  .mfaq-a {
    padding: 16px 20px;
    background: #ffffff;
    font-size: 14.5px;
    line-height: 1.7;
    color: #374151;
    border-top: 1px solid var(--theme-line);
  }

  .mfaq-a p {
    margin: 0;
  }

  .conclusion-box {
    background: var(--theme-mist);
    border: 1.5px solid var(--theme-line);
    border-radius: var(--r-md);
    padding: 28px;
  }

  .cb-rating-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .cb-score-num {
    font-size: 32px;
    font-weight: 900;
    color: #b24700;
    line-height: 1;
  }

  .cb-score-stars {
    font-size: 18px;
  }

  .cb-score-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--theme-ink);
  }

  .cb-summary-text {
    font-size: 16px;
    line-height: 1.75;
    margin-bottom: 24px !important;
  }

  .cb-action-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #ffffff;
    border: 1.5px solid var(--theme-line);
    border-radius: var(--r-sm);
    padding: 20px;
    gap: 20px;
    flex-wrap: wrap;
  }

  .cba-title {
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .cba-voucher {
    font-size: 14px;
    color: var(--theme-slate);
    margin-bottom: 6px;
  }

  .cba-voucher code {
    color: #b24700;
    font-weight: 800;
    font-size: 15px;
  }

  .cba-tip {
    font-size: 12px;
    color: #9ca3af;
    margin: 0;
  }

  /* Sidebar */
  .sidebar-card {
    background: #ffffff;
    border: 1px solid var(--theme-line);
    border-radius: var(--r-md);
    padding: 24px;
    margin-bottom: 20px;
  }

  .sticky-toc-card {
    position: sticky;
    top: 90px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }

  .sc-title {
    font-size: 17px;
    font-weight: 700;
    margin: 0 0 12px;
    color: var(--theme-ink);
  }

  .sc-desc {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--theme-slate);
    margin-bottom: 16px;
  }

  .btn-full {
    width: 100%;
    justify-content: center;
  }

  .sc-disclaimer {
    font-size: 11.5px;
    color: var(--theme-slate);
    text-align: center;
    margin: 8px 0 0;
    line-height: 1.4;
  }

  .monograph-toc {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .monograph-toc li a {
    display: flex;
    gap: 8px;
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--theme-slate);
    text-decoration: none;
    padding: 4px 6px;
    border-radius: 4px;
    transition: all 0.15s;
  }

  .monograph-toc li a:hover {
    background: var(--theme-mist);
    color: var(--theme-ink);
  }

  .monograph-toc .toc-num {
    font-weight: 700;
    color: #0b6cb2;
  }

  .quick-nav-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .quick-nav-list a {
    font-size: 13.5px;
    color: var(--theme-slate);
    text-decoration: none;
  }

  .quick-nav-list a:hover {
    color: var(--theme-ink);
    text-decoration: underline;
  }
</style>
