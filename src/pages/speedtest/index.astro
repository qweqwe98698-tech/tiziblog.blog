<script>
  // Coupon Copy functionality
  const copyBtn = document.getElementById('copyCouponBtn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('AMM');
        const origText = copyBtn.innerHTML;
        copyBtn.innerHTML = '已复制优惠码 AMM！';
        setTimeout(() => {
          copyBtn.innerHTML = origText;
        }, 2500);
      } catch (err) {
        console.error('Copy failed:', err);
      }
    });
  }

  // Speed Cards Filter
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chips .chip');
  const cards = document.querySelectorAll<HTMLElement>('.speed-card');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('is-active'));
      chip.classList.add('is-active');

      const filter = chip.dataset.filter || 'all';

      cards.forEach((card) => {
        let show = true;
        if (filter === 'iepl') {
          show = card.dataset.iepl === 'true';
        } else if (filter === 'client') {
          show = card.dataset.client === 'true';
        } else if (filter === 'chatgpt') {
          show = card.dataset.chatgpt === 'true';
        }

        card.style.display = show ? 'flex' : 'none';
      });
    });
  });

  // Lightbox Modal for Images
  const dialog = document.getElementById('imgDialog') as HTMLDialogElement | null;
  const modalImg = document.getElementById('modalImg') as HTMLImageElement | null;
  const modalCaption = document.getElementById('modalCaption');
  const closeBtn = document.getElementById('modalCloseBtn');

  if (dialog && modalImg) {
    document.querySelectorAll<HTMLElement>('[data-full-src]').forEach((el) => {
      el.addEventListener('click', () => {
        const src = el.dataset.fullSrc;
        const img = el.querySelector('img');
        const alt = img ? img.alt : '实测高清大图';
        if (src) {
          modalImg.src = src;
          if (modalCaption) modalCaption.textContent = alt;
          dialog.showModal();
        }
      });
    });

    closeBtn?.addEventListener('click', () => {
      dialog.close();
    });

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) {
        dialog.close();
      }
    });
  }
</script>
