    font-size: 1.1rem;
    color: var(--c-text, #e8ece9);
    margin-bottom: 0.35rem;
    display: block;
  }
  .nb-desc {
    font-size: 0.9rem;
    color: var(--c-text-muted, #b2b8b3);
    margin: 0;
    line-height: 1.6;
  }
  .nb-desc strong {
    color: var(--c-lime, #c8f14d);
  }
  .nb-right {
    flex-shrink: 0;
  }

  /* Platform Bar */
  .platform-bar {
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--c-border, #242524);
    padding-bottom: 1rem;
  }
  .platform-tabs {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
