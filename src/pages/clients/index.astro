    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2.5rem;
    gap: 1.5rem;
  }
  @media (max-width: 768px) {
    .novice-banner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .nb-left {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .accent {
    color: var(--c-lime, #c8f14d);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
