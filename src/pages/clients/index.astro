  }
  .cc-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .cc-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .cc-name {
    margin: 0;
    font-size: 1.3rem;
    color: var(--c-text, #e8ece9);
  }
  .cc-platform-tag {
    font-size: 0.7rem;
    color: var(--c-text-dim, #8b928c);
    letter-spacing: 0.05em;
  }
  .cc-badge {
    font-size: 0.75rem;
