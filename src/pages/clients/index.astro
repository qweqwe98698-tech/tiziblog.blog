<script>
  // Platform Tabs Switcher
  const tabs = document.querySelectorAll<HTMLButtonElement>('.platform-tabs .p-tab');
  const cards = document.querySelectorAll<HTMLElement>('.client-card');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('is-active');
      tab.setAttribute('aria-selected', 'true');

      const targetPlatform = tab.dataset.platform;

      cards.forEach((card) => {
        const p = card.dataset.platform;
        if (targetPlatform === p) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Trigger initial filter for active tab
  const activeTab = document.querySelector<HTMLButtonElement>('.platform-tabs .p-tab.is-active');
  if (activeTab) {
    const p = activeTab.dataset.platform;
    cards.forEach((c) => {
      c.style.display = c.dataset.platform === p ? 'flex' : 'none';
    });
  }
</script>
