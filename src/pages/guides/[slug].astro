---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Icon from '~/components/Icon.astro';
import { guides, type GuideArticle } from '~/data/guides';
import { brands } from '~/data/brands';
import siteConfig from '~/config/site';
import { graph, breadcrumbSchema, personSchema } from '~/lib/jsonld';

export const getStaticPaths = (async () => {
  return guides.map((guide, i) => ({
    params: { slug: guide.slug },
    props: {
      guide,
      prev: guides[(i - 1 + guides.length) % guides.length]!,
      next: guides[(i + 1) % guides.length]!,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  guide: GuideArticle;
  prev: GuideArticle;
  next: GuideArticle;
}

const { guide, prev, next } = Astro.props;
const pageUrl = `${siteConfig.url}/guides/${guide.slug}/`;

const recommendedBrands = brands.filter((b) => guide.recommendedBrandIds.includes(b.id));

const jsonLdNodes: Record<string, unknown>[] = [
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: '首页', url: `${siteConfig.url}/` },
    { name: '选购攻略', url: `${siteConfig.url}/guides/` },
    { name: guide.title, url: pageUrl },
  ]),
  {
    '@type': 'Article',
    headline: guide.title,
    description: guide.summary,
    datePublished: guide.publishDate,
    dateModified: guide.updateDate || guide.publishDate,
    author: {
      '@type': 'Person',
      name: '梯子Blog 网络评测实验室',
      url: `${siteConfig.url}/about/`,
    },
    publisher: {
      '@type': 'Organization',
      name: '梯子Blog',
      url: siteConfig.url,
      logo: {
        '@type': 'ImageObject',
        url: `${siteConfig.url}/images/tiziblog-logo-light.svg`,
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': pageUrl,
    },
  },
];

if (guide.faqs && guide.faqs.length > 0) {
  jsonLdNodes.push({
    '@type': 'FAQPage',
    mainEntity: guide.faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer.replace(/<[^>]+>/g, ''),
      },
    })),
  });
}

const jsonLd = graph(jsonLdNodes);
---

<BaseLayout
  title={`${guide.title} — 梯子Blog`}
  description={guide.summary}
  jsonLd={jsonLd}
>
  <article class="guide-article">
    <!-- Article Header -->
    <header class="guide-header">
      <div class="wrap sec-tight">
        <Breadcrumbs
          items={[
            { label: '选购攻略', href: '/guides/' },
            { label: guide.title },
          ]}
        />

        <div class="header-inner rev">
          <div class="guide-badge-row">
            <span class="badge-cat">{guide.category}</span>
            <span class="badge-role">{guide.pageRole.split('(')[0]}</span>
            <span class="badge-time">{guide.readTime}</span>
            <span class="badge-date">更新于: {guide.updateDate || guide.publishDate}</span>
          </div>

          <h1 class="d2 guide-h1">{guide.title}</h1>
          <p class="lead guide-lead">{guide.summary}</p>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <div class="wrap sec" style="padding-top:1.5rem">
      <div class="article-layout">
        <!-- Sidebar: Table of Contents & Author Info -->
        <aside class="article-aside">
          <div class="aside-sticky">
            <div class="toc-box">
              <h3 class="toc-title">目录导航</h3>
              <ul class="toc-list">
                <li>
                  <a href="#takeaways">核心结论速览</a>
                </li>
                <li>
                  <a href="#answer-block">AEO 实体回答</a>
                </li>
                {guide.flowchart && (
                  <li>
                    <a href="#flowchart">选型决策流程</a>
                  </li>
                )}
                {guide.comparisonTable && (
                  <li>
                    <a href="#comparison-table">核心参数对照</a>
                  </li>
                )}
                {
                  guide.content.map((sec, idx) => (
                    <li>
                      <a href={`#section-${idx + 1}`}>{sec.heading}</a>
                    </li>
                  ))
                }
                {guide.troubleshootingCases && (
                  <li>
                    <a href="#troubleshooting">排障案例实战</a>
                  </li>
                )}
                {guide.faqs && guide.faqs.length > 0 && (
                  <li>
                    <a href="#faqs">常见问题答疑 (FAQ)</a>
                  </li>
                )}
                <li>
                  <a href="#recommended-brands">严选落地专线</a>
                </li>
                <li>
                  <a href="#topic-matrix">站内矩阵与延伸</a>
                </li>
              </ul>
            </div>

            <div class="author-box">
              <div class="author-avatar">
                <img src="/images/hero-portrait.webp" alt="梯子Blog 评测实验室" />
              </div>
              <div class="author-info">
                <strong>梯子Blog 评测实验室</strong>
                <span>坚持真实可观测网络实测</span>
              </div>
            </div>
          </div>
        </aside>

        <!-- Main Body Content -->
        <div class="article-main">
          <!-- Key Takeaways Callout -->
          <div class="takeaways-callout rev" id="takeaways">
            <div class="tc-head">
              <Icon name="spark" class="ic-xs tc-icon" />
              <strong>核心要点速览（Key Takeaways）</strong>
            </div>
            <ul>
              {
                guide.keyTakeaways.map((takeaway) => (
                  <li>
                    <Icon name="check" class="ic-xxs" />
                    <span>{takeaway}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Answer Block for AEO / GEO -->
          {guide.answerBlock && (
            <div class="answer-block rev" id="answer-block">
              <div class="ab-head">
                <span class="ab-pill">GEO / AEO 实体答案块</span>
                <span class="ab-meta">AI 引用与决策核心摘要</span>
              </div>
              <h3 class="ab-question">{guide.answerBlock.question}</h3>
              <p class="ab-answer">{guide.answerBlock.answer}</p>
              <div class="ab-foot">
                <span>* 本答案由评测实验室依据真机晚高峰压测与协议底层 RFC 验证归纳，适于作为 AI 搜索引擎引证。</span>
              </div>
            </div>
          )}

          <!-- Flowchart / Decision Tree -->
          {guide.flowchart && (
            <div class="flowchart-box rev" id="flowchart">
              <div class="fc-head">
                <Icon name="spark" class="ic-xs" />
                <h3>{guide.flowchart.title}</h3>
              </div>
              <div class="fc-steps">
                {guide.flowchart.steps.map((st, sIdx) => (
                  <div class="fc-step-item">
                    <div class="fc-step-num">{sIdx + 1}</div>
                    <div class="fc-step-body">
                      <div class="fc-step-line">
                        <strong>{st.step}</strong>
                        {st.tag && <span class="fc-step-tag">{st.tag}</span>}
                      </div>
                      <p set:html={st.desc} />
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Comparison Table -->
          {guide.comparisonTable && (
            <div class="comparison-table-wrap rev" id="comparison-table">
              <div class="table-caption">
                <strong>{guide.comparisonTable.caption}</strong>
              </div>
              <div class="table-responsive">
                <table class="guide-table">
                  <thead>
                    <tr>
                      {guide.comparisonTable.headers.map((h) => (
                        <th>{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {guide.comparisonTable.rows.map((row) => (
                      <tr>
                        {row.map((cell, cIdx) => (
                          <td class={cIdx === 0 ? 'td-primary' : ''} set:html={cell} />
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          <!-- Content Sections -->
          <div class="article-prose rev rev-d1">
            {
              guide.content.map((sec, idx) => (
                <section class="prose-sec" id={`section-${idx + 1}`}>
                  <h2>{sec.heading}</h2>
                  <p set:html={sec.body} />

                  {sec.subsections && sec.subsections.length > 0 && (
                    <div class="subsections">
                      {sec.subsections.map((sub) => (
                        <div class="subsection-item">
                          <h3>{sub.title}</h3>
                          <p set:html={sub.body} />
                        </div>
                      ))}
                    </div>
                  )}
                </section>
              ))
            }
          </div>

          <!-- Practical Code / Command Snippet -->
          {guide.codeSnippet && (
            <div class="code-snippet-box rev" id="code-snippet">
              <div class="csb-head">
                <span class="csb-title">💻 {guide.codeSnippet.title}</span>
                <span class="csb-lang">{guide.codeSnippet.language}</span>
              </div>
              <pre class="csb-code"><code>{guide.codeSnippet.code}</code></pre>
              {guide.codeSnippet.note && <p class="csb-note">* {guide.codeSnippet.note}</p>}
            </div>
          )}

          <!-- Troubleshooting Cases -->
          {guide.troubleshootingCases && guide.troubleshootingCases.length > 0 && (
            <div class="troubleshoot-box rev" id="troubleshooting">
              <h3 class="tb-head">🛠️ 真实排障案例实战与排查命令</h3>
              <div class="tb-list">
                {guide.troubleshootingCases.map((tc) => (
                  <div class="tb-card">
                    <div class="tb-item">
                      <span class="tb-badge danger">故障表现</span>
                      <p>{tc.symptom}</p>
                    </div>
                    <div class="tb-item">
                      <span class="tb-badge warn">底层病因</span>
                      <p>{tc.rootCause}</p>
                    </div>
                    <div class="tb-item">
                      <span class="tb-badge success">解决方案</span>
                      <p set:html={tc.solution} />
                    </div>
                    {tc.verifyCommand && (
                      <div class="tb-cmd">
                        <span class="cmd-label">排查验证命令：</span>
                        <code>{tc.verifyCommand}</code>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- FAQs Section -->
          {guide.faqs && guide.faqs.length > 0 && (
            <section class="guide-faq-sec rev" id="faqs">
              <h2 class="d3">❓ 常见问题深度答疑 (FAQ)</h2>
              <p class="section-sub">覆盖用户选型、协议机制与日常使用中最常见的高频长尾疑难：</p>
              <div class="faq-cards">
                {guide.faqs.map((faq, fIdx) => (
                  <details class="faq-item" open={fIdx === 0}>
                    <summary class="faq-summary">
                      <span class="faq-q">{faq.question}</span>
                      <Icon name="plus" class="ic-xs" />
                    </summary>
                    <div class="faq-body">
                      <p set:html={faq.answer} />
                    </div>
                  </details>
                ))}
              </div>
            </section>
          )}

          <!-- Recommended Brands Showcase -->
          <section class="recom-section rev rev-d2" id="recommended-brands">
            <div class="recom-head">
              <p class="eyebrow">Top Picks for This Guide</p>
              <h2 class="d3">基于本篇策略推荐的严选落地专线</h2>
              <p class="recom-intro">
                以下品牌均经过真机晚高峰测速与解锁状态核验，符合本篇攻略的选型标准：
              </p>
            </div>

            <div class="recom-grid">
              {
                recommendedBrands.map((b) => (
                  <div class="recom-card">
                    <div class="rc-head">
                      <div>
                        <span class="rc-rank">#{b.rank}</span>
                        <h3 class="rc-name">
                          <a href={`/brands/${b.id}/`}>{b.name}</a>
                        </h3>
                      </div>
                      <span class="rc-price">{b.pricingMin}</span>
                    </div>

                    <p class="rc-desc">{b.summary}</p>

                    <div class="rc-tags">
                      {b.lineType.map((lt) => (
                        <span class="rc-tag">{lt}</span>
                      ))}
                      {b.discountCode && <span class="rc-code">券码: {b.discountCode}</span>}
                    </div>

                    <div class="rc-actions">
                      <a href={`/brands/${b.id}/`} class="btn btn-outline btn-sm">查看评测</a>
                      <a
                        href={b.affUrl}
                        target="_blank"
                        rel="nofollow sponsored noopener"
                        class="btn btn-lime btn-sm"
                      >
                        直达官网 →
                      </a>
                    </div>
                  </div>
                ))
              }
            </div>
          </section>

          <!-- Topic Cluster & Internal Links Network -->
          <nav class="topic-cluster-nav rev" id="topic-matrix" aria-label="站内内容矩阵与内部链接">
            <div class="tcn-head">
              <Icon name="spark" class="ic-xs" />
              <h3>站内四层链接矩阵与延伸阅读</h3>
            </div>
            <div class="tcn-grid">
              <div class="tcn-col">
                <span class="tcn-tag">第一层：向上所属支柱</span>
                <ul>
                  {guide.internalLinkPlan.parent.map((p) => (
                    <li><a href={p.url}>{p.title}</a></li>
                  ))}
                </ul>
              </div>
              <div class="tcn-col">
                <span class="tcn-tag">第二层：横向兄弟关联</span>
                <ul>
                  {guide.internalLinkPlan.siblings.map((s) => (
                    <li><a href={s.url}>{s.title}</a></li>
                  ))}
                </ul>
              </div>
              <div class="tcn-col">
                <span class="tcn-tag">第三层：向下真机实测</span>
                <ul>
                  {guide.internalLinkPlan.children.map((c) => (
                    <li><a href={c.url}>{c.title}</a></li>
                  ))}
                </ul>
              </div>
            </div>
          </nav>

          <!-- Prev / Next Pagination -->
          <nav class="guide-nav-bar rev" aria-label="相邻攻略切换">
            <a href={`/guides/${prev.slug}/`} class="nav-prev">
              <span class="nav-sub">← 上一篇攻略</span>
              <strong class="nav-title">{prev.title}</strong>
            </a>
            <a href={`/guides/${next.slug}/`} class="nav-next">
              <span class="nav-sub">下一篇攻略 →</span>
              <strong class="nav-title">{next.title}</strong>
            </a>
          </nav>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .guide-header {
    background: linear-gradient(180deg, #161816 0%, #101110 100%);
    border-bottom: 1px solid var(--c-border, #242524);
    padding: 2.5rem 0 1rem;
  }
  .header-inner {
    max-width: 860px;
    margin-top: 1.5rem;
  }
  .guide-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.8rem;
    color: var(--c-text-dim, #8b928c);
    flex-wrap: wrap;
  }
  .badge-cat {
    background: rgba(200, 241, 77, 0.15);
    color: var(--c-lime, #c8f14d);
    border: 1px solid rgba(200, 241, 77, 0.3);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-weight: 600;
  }
  .badge-role {
    background: rgba(255, 255, 255, 0.06);
    color: var(--c-text-muted, #b2b8b3);
    border: 1px solid var(--c-border, #242524);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    font-size: 0.75rem;
  }
  .guide-h1 {
    margin: 0 0 1rem;
    color: var(--c-text, #e8ece9);
    line-height: 1.25;
  }
  .guide-lead {
    color: var(--c-text-muted, #b2b8b3);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0;
  }

  /* Article Layout */
  .article-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3.5rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .article-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* Aside Sticky */
  .aside-sticky {
    position: sticky;
    top: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .toc-box {
    background: var(--c-surface, #151615);
    border: 1px solid var(--c-border, #242524);
    border-radius: 12px;
    padding: 1.25rem;
  }
  .toc-title {
    font-size: 0.95rem;
    color: var(--c-lime, #c8f14d);
    margin: 0 0 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .toc-list a {
    font-size: 0.85rem;
    color: var(--c-text-muted, #b2b8b3);
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.2s;
  }
  .toc-list a:hover {
    color: var(--c-lime, #c8f14d);
  }
  .author-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--c-surface, #151615);
    border: 1px solid var(--c-border, #242524);
    border-radius: 12px;
    padding: 1rem;
  }
  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--c-lime, #c8f14d);
  }
  .author-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .author-info {
    display: flex;
    flex-direction: column;
  }
  .author-info strong {
    font-size: 0.85rem;
    color: var(--c-text, #e8ece9);
  }
  .author-info span {
    font-size: 0.75rem;
    color: var(--c-text-dim, #8b928c);
  }

  /* Main Body */
  .article-main {
    max-width: 820px;
  }
  .takeaways-callout {
    background: rgba(200, 241, 77, 0.08);
    border: 1.5px solid rgba(200, 241, 77, 0.25);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  .tc-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }
  .tc-icon {
    color: var(--c-lime, #c8f14d);
  }
  .tc-head strong {
    font-size: 1rem;
    color: var(--c-lime, #c8f14d);
  }
  .takeaways-callout ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .takeaways-callout li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--c-text, #e8ece9);
    line-height: 1.7;
  }
  .takeaways-callout li :global(.ic),
  .takeaways-callout li :global(svg) {
    width: 13px !important;
    height: 13px !important;
    min-width: 13px !important;
    max-width: 13px !important;
    color: var(--c-lime, #c8f14d);
    flex-shrink: 0 !important;
    margin-top: 5px;
  }

  /* Answer Block */
  .answer-block {
    background: linear-gradient(135deg, rgba(200, 241, 77, 0.12) 0%, rgba(26, 29, 26, 0.9) 100%);
    border: 1.5px solid var(--c-lime, #c8f14d);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }
  .ab-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }
  .ab-pill {
    background: var(--c-lime, #c8f14d);
    color: #101110;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    text-transform: uppercase;
  }
  .ab-meta {
    font-size: 0.75rem;
    color: var(--c-text-dim, #8b928c);
  }
  .ab-question {
    font-size: 1.15rem;
    color: #ffffff;
    margin: 0 0 0.85rem;
    line-height: 1.4;
  }
  .ab-answer {
    color: var(--c-text, #e8ece9);
    font-size: 0.98rem;
    line-height: 1.8;
    margin: 0 0 0.85rem;
  }
  .ab-foot {
    border-top: 1px dashed rgba(255, 255, 255, 0.12);
    padding-top: 0.6rem;
    font-size: 0.78rem;
    color: var(--c-text-dim, #8b928c);
  }

  /* Flowchart Box */
  .flowchart-box {
    background: var(--c-surface, #151615);
    border: 1px solid var(--c-border, #242524);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .fc-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    color: var(--c-lime, #c8f14d);
  }
  .fc-head h3 {
    margin: 0;
    font-size: 1.15rem;
    color: var(--c-text, #e8ece9);
  }
  .fc-steps {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .fc-step-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--c-border, #242524);
    border-radius: 8px;
    padding: 1rem;
  }
  .fc-step-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(200, 241, 77, 0.15);
    color: var(--c-lime, #c8f14d);
    border: 1px solid var(--c-lime, #c8f14d);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
    flex-shrink: 0;
  }
  .fc-step-body {
    flex: 1;
