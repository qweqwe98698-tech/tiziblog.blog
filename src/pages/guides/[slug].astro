---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Icon from '~/components/Icon.astro';
import { guides, type GuideArticle } from '~/data/guides';
import { brands } from '~/data/brands';
import siteConfig from '~/config/site';
import { graph, breadcrumbSchema, personSchema } from '~/lib/jsonld';

export const getStaticPaths = (async () => {
  return guides.map((guide, i) => ({
    params: { slug: guide.slug },
    props: {
      guide,
      prev: guides[(i - 1 + guides.length) % guides.length]!,
      next: guides[(i + 1) % guides.length]!,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  guide: GuideArticle;
  prev: GuideArticle;
  next: GuideArticle;
}

const { guide, prev, next } = Astro.props;
const pageUrl = `${siteConfig.url}/guides/${guide.slug}/`;

const recommendedBrands = brands.filter((b) => guide.recommendedBrandIds.includes(b.id));

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: '首页', url: `${siteConfig.url}/` },
    { name: '选购攻略', url: `${siteConfig.url}/guides/` },
    { name: guide.title, url: pageUrl },
  ]),
  {
    '@type': 'Article',
    headline: guide.title,
    description: guide.summary,
    datePublished: guide.publishDate,
    dateModified: guide.publishDate,
    author: {
      '@type': 'Person',
      name: '梯子Blog 网络评测实验室',
      url: `${siteConfig.url}/about/`,
    },
    publisher: {
      '@type': 'Organization',
      name: '梯子Blog',
      url: siteConfig.url,
      logo: {
        '@type': 'ImageObject',
        url: `${siteConfig.url}/images/tiziblog-logo-light.svg`,
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': pageUrl,
    },
  },
]);
---

<BaseLayout
  title={`${guide.title} — 梯子Blog`}
  description={guide.summary}
  jsonLd={jsonLd}
>
  <article class="guide-article">
    <!-- Article Header -->
    <header class="guide-header">
      <div class="wrap sec-tight">
        <Breadcrumbs
          items={[
            { label: '选购攻略', href: '/guides/' },
            { label: guide.title },
          ]}
        />

        <div class="header-inner rev">
          <div class="guide-badge-row">
            <span class="badge-cat">{guide.category}</span>
            <span class="badge-time">{guide.readTime}</span>
            <span class="badge-date">{guide.publishDate}</span>
          </div>

          <h1 class="d2 guide-h1">{guide.title}</h1>
          <p class="lead guide-lead">{guide.summary}</p>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <div class="wrap sec" style="padding-top:1.5rem">
      <div class="article-layout">
        <!-- Sidebar: Table of Contents & Author Info -->
        <aside class="article-aside">
          <div class="aside-sticky">
            <div class="toc-box">
              <h3 class="toc-title">目录导航</h3>
              <ul class="toc-list">
                {
                  guide.content.map((sec, idx) => (
                    <li>
                      <a href={`#section-${idx + 1}`}>{sec.heading}</a>
                    </li>
                  ))
                }
                <li>
                  <a href="#recommended-brands">本篇推荐严选专线</a>
                </li>
              </ul>
            </div>

            <div class="author-box">
              <div class="author-avatar">
                <img src="/images/hero-portrait.webp" alt="梯子Blog 评测实验室" />
              </div>
              <div class="author-info">
                <strong>梯子Blog 评测组</strong>
                <span>坚持真实可观测实测数据</span>
              </div>
            </div>
          </div>
        </aside>

        <!-- Main Body Content -->
        <div class="article-main">
          <!-- Key Takeaways Callout -->
          <div class="takeaways-callout rev">
            <div class="tc-head">
              <Icon name="spark" class="ic-xs tc-icon" />
              <strong>核心要点速览（Key Takeaways）</strong>
            </div>
            <ul>
              {
                guide.keyTakeaways.map((takeaway) => (
                  <li>
                    <Icon name="check" class="ic-xxs" />
                    <span>{takeaway}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Content Sections -->
          <div class="article-prose rev rev-d1">
            {
              guide.content.map((sec, idx) => (
                <section class="prose-sec" id={`section-${idx + 1}`}>
                  <h2>{sec.heading}</h2>
                  <p set:html={sec.body} />

                  {sec.subsections && sec.subsections.length > 0 && (
                    <div class="subsections">
                      {sec.subsections.map((sub) => (
                        <div class="subsection-item">
                          <h3>{sub.title}</h3>
                          <p set:html={sub.body} />
                        </div>
                      ))}
                    </div>
                  )}
                </section>
              ))
            }
          </div>

          <!-- Recommended Brands Showcase -->
          <section class="recom-section rev rev-d2" id="recommended-brands">
            <div class="recom-head">
              <p class="eyebrow">Top Picks for This Guide</p>
              <h2 class="d3">基于本篇策略推荐的严选专线</h2>
              <p class="recom-intro">
                以下品牌均经过真机晚高峰测速与解锁状态核验，符合本篇攻略的选型标准：
              </p>
            </div>

            <div class="recom-grid">
              {
                recommendedBrands.map((b) => (
                  <div class="recom-card">
                    <div class="rc-head">
                      <div>
                        <span class="rc-rank">#{b.rank}</span>
                        <h3 class="rc-name">
                          <a href={`/brands/${b.id}/`}>{b.name}</a>
                        </h3>
                      </div>
                      <span class="rc-price">{b.pricingMin}</span>
                    </div>

                    <p class="rc-desc">{b.summary}</p>

                    <div class="rc-tags">
                      {b.lineType.map((lt) => (
                        <span class="rc-tag">{lt}</span>
                      ))}
                      {b.discountCode && <span class="rc-code">券码: {b.discountCode}</span>}
                    </div>

                    <div class="rc-actions">
                      <a href={`/brands/${b.id}/`} class="btn btn-outline btn-sm">查看评测</a>
                      <a
                        href={b.affUrl}
                        target="_blank"
                        rel="nofollow sponsored noopener"
                        class="btn btn-lime btn-sm"
                      >
                        直达官网 →
                      </a>
                    </div>
                  </div>
                ))
              }
            </div>
          </section>

          <!-- Prev / Next Pagination -->
          <nav class="guide-nav-bar rev" aria-label="相邻攻略切换">
            <a href={`/guides/${prev.slug}/`} class="nav-prev">
              <span class="nav-sub">← 上一篇攻略</span>
              <strong class="nav-title">{prev.title}</strong>
            </a>
            <a href={`/guides/${next.slug}/`} class="nav-next">
              <span class="nav-sub">下一篇攻略 →</span>
              <strong class="nav-title">{next.title}</strong>
            </a>
          </nav>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .guide-header {
    background: linear-gradient(180deg, #161816 0%, #101110 100%);
    border-bottom: 1px solid var(--c-border, #242524);
    padding: 2.5rem 0 1rem;
  }
  .header-inner {
    max-width: 860px;
    margin-top: 1.5rem;
  }
  .guide-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.8rem;
    color: var(--c-text-dim, #8b928c);
    flex-wrap: wrap;
  }
  .badge-cat {
    background: rgba(200, 241, 77, 0.15);
    color: var(--c-lime, #c8f14d);
    border: 1px solid rgba(200, 241, 77, 0.3);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-weight: 600;
  }
  .guide-h1 {
    margin: 0 0 1rem;
    color: var(--c-text, #e8ece9);
    line-height: 1.25;
  }
  .guide-lead {
    color: var(--c-text-muted, #b2b8b3);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0;
  }

  /* Article Layout */
  .article-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3.5rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .article-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* Aside Sticky */
  .aside-sticky {
    position: sticky;
    top: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .toc-box {
    background: var(--c-surface, #151615);
    border: 1px solid var(--c-border, #242524);
    border-radius: 12px;
    padding: 1.25rem;
  }
  .toc-title {
    font-size: 0.95rem;
    color: var(--c-lime, #c8f14d);
    margin: 0 0 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .toc-list a {
    font-size: 0.85rem;
    color: var(--c-text-muted, #b2b8b3);
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.2s;
  }
  .toc-list a:hover {
    color: var(--c-lime, #c8f14d);
  }
  .author-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--c-surface, #151615);
    border: 1px solid var(--c-border, #242524);
    border-radius: 12px;
    padding: 1rem;
  }
  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--c-lime, #c8f14d);
  }
  .author-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .author-info {
    display: flex;
    flex-direction: column;
  }
  .author-info strong {
    font-size: 0.85rem;
    color: var(--c-text, #e8ece9);
  }
  .author-info span {
    font-size: 0.75rem;
    color: var(--c-text-dim, #8b928c);
  }

  /* Main Body */
  .article-main {
    max-width: 820px;
  }
  .takeaways-callout {
    background: rgba(200, 241, 77, 0.08);
    border: 1.5px solid rgba(200, 241, 77, 0.25);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .tc-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }
  .tc-icon {
    color: var(--c-lime, #c8f14d);
  }
  .tc-head strong {
    font-size: 1rem;
    color: var(--c-lime, #c8f14d);
  }
  .takeaways-callout ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .takeaways-callout li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--c-text, #e8ece9);
    line-height: 1.7;
  }
  .takeaways-callout li :global(.ic),
  .takeaways-callout li :global(svg) {
    width: 14px !important;
    height: 14px !important;
    min-width: 14px !important;
    max-width: 14px !important;
    color: var(--c-lime, #c8f14d);
    flex-shrink: 0 !important;
    margin-top: 5px;
  }

  /* Article Prose */
  .article-prose {
    color: var(--c-text-muted, #b2b8b3);
    line-height: 1.8;
    font-size: 1rem;
  }
  .prose-sec {
    margin-bottom: 3rem;
    scroll-margin-top: 6rem;
  }
  .prose-sec h2 {
    color: var(--c-text, #e8ece9);
    font-size: 1.5rem;
    margin: 0 0 1rem;
    border-left: 3px solid var(--c-lime, #c8f14d);
    padding-left: 0.85rem;
  }
  .prose-sec p {
    margin: 0 0 1.25rem;
  }
  .prose-sec :global(strong) {
    color: var(--c-lime, #c8f14d);
  }
  .subsections {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .subsection-item {
    background: var(--c-surface, #151615);
    border: 1px solid var(--c-border, #242524);
    border-radius: 10px;
    padding: 1.25rem;
  }
  .subsection-item h3 {
    margin: 0 0 0.6rem;
    font-size: 1.15rem;
    color: var(--c-text, #e8ece9);
  }
  .subsection-item p {
    margin: 0;
    font-size: 0.95rem;
  }

  /* Recommended Brands Section */
  .recom-section {
    background: var(--c-surface, #151615);
    border: 1px solid var(--c-border, #242524);
    border-radius: 16px;
    padding: 2.5rem;
    margin: 4rem 0 3rem;
    scroll-margin-top: 6rem;
  }
  @media (max-width: 600px) {
    .recom-section {
      padding: 1.25rem;
    }
  }
  .recom-head {
    margin-bottom: 2rem;
  }
  .recom-head h2 {
    margin: 0.5rem 0 0.75rem;
  }
  .recom-intro {
    color: var(--c-text-muted, #b2b8b3);
    margin: 0;
    font-size: 0.95rem;
  }
  .recom-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .recom-card {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--c-border, #242524);
    border-radius: 10px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .rc-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .rc-rank {
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.08);
    color: var(--c-text-dim, #8b928c);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    margin-right: 0.4rem;
  }
  .rc-name {
    display: inline;
    margin: 0;
    font-size: 1.2rem;
  }
  .rc-name a {
    color: var(--c-text, #e8ece9);
    text-decoration: none;
  }
  .rc-name a:hover {
    color: var(--c-lime, #c8f14d);
  }
  .rc-price {
    font-weight: 700;
    color: var(--c-lime, #c8f14d);
    font-size: 0.95rem;
  }
  .rc-desc {
    margin: 0;
    font-size: 0.85rem;
    color: var(--c-text-muted, #b2b8b3);
    line-height: 1.6;
  }
  .rc-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .rc-tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--c-text-dim, #8b928c);
  }
  .rc-code {
    font-size: 0.75rem;
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    background: rgba(255, 215, 0, 0.12);
    color: #ffd700;
    font-family: monospace;
  }
  .rc-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: auto;
  }
  .rc-actions .btn {
    width: 100%;
    justify-content: center;
    border-radius: 999px;
  }
  .rc-actions .btn-outline {
    background: rgba(255, 255, 255, 0.08) !important;
    color: #ffffff !important;
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.28) !important;
    font-weight: 600;
  }
  .rc-actions .btn-outline:hover {
    background: rgba(200, 241, 77, 0.16) !important;
    color: var(--c-lime, #c8f14d) !important;
    box-shadow: inset 0 0 0 1.5px var(--c-lime, #c8f14d) !important;
  }
  .rc-actions .btn-lime {
    background: var(--c-lime, #c8f14d) !important;
    color: #101110 !important;
    font-weight: 700;
  }
  .rc-actions .btn-lime:hover {
    background: #d8f56e !important;
  }

  /* Guide Nav Bar */
  .guide-nav-bar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    border-top: 1px solid var(--c-border, #242524);
    padding-top: 2rem;
  }
  @media (max-width: 600px) {
    .guide-nav-bar {
      grid-template-columns: 1fr;
    }
  }
  .nav-prev,
  .nav-next {
    background: var(--c-surface, #151615);
    border: 1px solid var(--c-border, #242524);
    border-radius: 10px;
    padding: 1.25rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: all 0.2s;
  }
  .nav-prev:hover,
  .nav-next:hover {
    border-color: var(--c-lime, #c8f14d);
    transform: translateY(-2px);
  }
  .nav-sub {
    font-size: 0.75rem;
    color: var(--c-lime, #c8f14d);
    text-transform: uppercase;
  }
  .nav-title {
    font-size: 0.95rem;
    color: var(--c-text, #e8ece9);
    line-height: 1.4;
  }
</style>
