---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Icon from '~/components/Icon.astro';
import { brands, type BrandData } from '~/data/brands';
import { guangsuReviewDossier } from '~/data/brandReviews/guangsu';
import siteConfig from '~/config/site';
import { graph, breadcrumbSchema, personSchema } from '~/lib/jsonld';

export const getStaticPaths = (async () => {
  return brands.map((brand, i) => ({
    params: { slug: brand.id },
    props: {
      brand,
      prev: brands[(i - 1 + brands.length) % brands.length]!,
      next: brands[(i + 1) % brands.length]!,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  brand: BrandData;
  prev: BrandData;
  next: BrandData;
}

const { brand, prev, next } = Astro.props;
const pageUrl = `${siteConfig.url}/brands/${brand.id}/`;
const isGuangsu = brand.id === 'guangsu';

const pageTitle = isGuangsu
  ? guangsuReviewDossier.seoTitle
  : `${brand.name}怎么样？2026测速实测、套餐价格与流媒体/ChatGPT解锁评测 — 梯子Blog`;

const pageDescription = isGuangsu
  ? guangsuReviewDossier.seoDescription
  : `${brand.name} 深度横评：起步资费 ${brand.pricingMin}，涵盖 ${brand.lineType.join(' / ')} 线路架构，包含 ${brand.speedImage ? '2026 真机测速图、' : ''}套餐价格表、AI及流媒体解锁实测与避坑指南。`;

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: '首页', url: `${siteConfig.url}/` },
    { name: '42家机场品牌库', url: `${siteConfig.url}/brands/` },
    { name: brand.name, url: pageUrl },
  ]),
  {
    '@type': 'Product',
    name: `${brand.name} 机场加速服务`,
    description: brand.summary,
    brand: { '@type': 'Brand', name: brand.name },
    offers: isGuangsu
      ? {
          '@type': 'AggregateOffer',
          priceCurrency: 'CNY',
          lowPrice: '25',
          highPrice: '680',
          offerCount: 7,
        }
      : {
          '@type': 'AggregateOffer',
          priceCurrency: 'CNY',
          lowPrice: brand.pricingMin.replace(/[^0-9.]/g, '') || '8',
          offerCount: brand.plans.length || 1,
        },
    review: {
      '@type': 'Review',
      reviewRating: {
        '@type': 'Rating',
        ratingValue: isGuangsu ? '4.88' : (brand.rank <= 3 ? '4.9' : brand.rank <= 10 ? '4.7' : '4.4'),
        bestRating: '5',
      },
      author: { '@type': 'Person', name: '梯子Blog 评测实验室' },
      datePublished: isGuangsu ? guangsuReviewDossier.lastUpdated : brand.verifiedDate,
    },
  },
  {
    '@type': 'FAQPage',
    mainEntity: isGuangsu
      ? guangsuReviewDossier.faqItems.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.a,
          },
        }))
      : [
          {
            '@type': 'Question',
            name: `${brand.name} 支持哪些客户端？新手如何导入？`,
            acceptedAnswer: {
              '@type': 'Answer',
              text: `${brand.name} ${brand.hasCustomClient ? '提供免配置自研一键客户端，同时' : ''}兼容 Clash Verge Rev、Shadowrocket (小火箭)、v2rayN、sing-box 等主流通用客户端订阅。`,
            },
          },
          {
            '@type': 'Question',
            name: `${brand.name} 的节点能否解锁 ChatGPT 和 Netflix？`,
            acceptedAnswer: {
              '@type': 'Answer',
              text: `实测结果显示，${brand.name} 对 Netflix 和主流视频平台支持较好；ChatGPT 与 Claude 支持状态为：${brand.unlocks.chatgpt === 'supported' ? '原生全解锁' : '部分专线节点支持，建议切换指定解锁节点'}。`,
            },
          },
          {
            '@type': 'Question',
            name: `${brand.name} 是否有最新优惠码？`,
            acceptedAnswer: {
              '@type': 'Answer',
              text: brand.discountCode
                ? `${brand.name} 当前可用专属优惠券码为 [${brand.discountCode}]，结账时填入可享对应立减或折扣。`
                : `${brand.name} 当前暂未提供公开优惠码，建议关注官方活动或直接选择高性价比周期套餐。`,
            },
          },
        ],
  },
]);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
  appendSiteName={!isGuangsu}
>
  <article>
    <!-- Brand Header -->
    <header class="wrap phero">
      <div class="phero-in rev">
        <Breadcrumbs
          items={[
            { label: '42家机场品牌库', href: '/brands/' },
            { label: brand.name },
          ]}
        />

        <div class="brand-hero-head">
          <div class="brand-title-line">
            <span class="rank-tag">#{brand.rank}</span>
            <h1 class="d1 brand-h1">{brand.name}</h1>
            {brand.isMainPromo && <span class="pill-main">本站第一主推</span>}
            {brand.hasCustomClient && <span class="pill-app">配备自研客户端</span>}
            {isGuangsu && <span class="pill-monograph">1.3万字专著级深度实测</span>}
          </div>

          <div class="brand-hero-actions">
            {
              brand.affUrl && (
                <a
                  href={brand.affUrl}
                  target="_blank"
                  rel="nofollow sponsored noopener"
                  class="btn btn-lime btn-lg"
                >
                  <span>直达 {brand.name} 官网注册</span>
                  <Icon name="arrow" class="ic-sm" />
                </a>
              )
            }
            {
              brand.discountCode && (
                <button
                  type="button"
                  class="btn-copy-code"
                  data-code={brand.discountCode}
                  id="copyBtn"
                >
                  <span>优惠码: <code>{brand.discountCode}</code></span>
                  <span class="copy-tip">(点击复制)</span>
                </button>
              )
            }
          </div>
        </div>

        <p class="brand-lead-desc">{brand.summary}</p>

        <!-- Tech Spec Badges -->
        <div class="spec-badges">
          <div class="spec-pill">
            <span class="lbl">线路架构</span>
            <strong>{brand.lineType.join(' + ')}</strong>
          </div>
          <div class="spec-pill">
            <span class="lbl">支持协议</span>
            <strong>{brand.protocols.join(', ')}</strong>
          </div>
          <div class="spec-pill">
            <span class="lbl">最低入门</span>
            <strong>{brand.pricingMin}</strong>
          </div>
          <div class="spec-pill">
            <span class="lbl">运营历史</span>
            <strong>{brand.established}</strong>
          </div>
          <div class="spec-pill">
            <span class="lbl">数据状态</span>
            <strong>{brand.dataStatus === 'measured' ? '真机实测' : '官方标称'}</strong>
          </div>
        </div>
      </div>
    </header>

    <div class="wrap sec" style="padding-top:0">
      <div class="brand-content-grid">
        <!-- Main Column -->
        <div class="brand-main-col">
          {isGuangsu && (
            <div class="monograph-container">
              {guangsuReviewDossier.chapters.map((chapter) => (
                <section class="card-section rev monograph-section" id={chapter.anchor}>
                  <div class="section-title-wrap">
                    <h2 class="d3 mono-chapter-title">{chapter.title}</h2>
                    {chapter.badge && <span class="badge-measured">{chapter.badge}</span>}
                  </div>
                  <p class="section-sub mono-summary">{chapter.summary}</p>
                  <div class="mono-content-body" set:html={chapter.contentHtml} />
                </section>
              ))}
            </div>
          )}

          {!isGuangsu && (
            <div class="standard-brand-sections">
              {/* Real Speed Test Showcase */}
              <section class="card-section rev" id="speedtest">
                <div class="section-title-wrap">
                  <h2 class="d3">⚡ 节点测速实测报告</h2>
                  {brand.speedImage ? (
                    <span class="badge-measured">真机抓包实测</span>
                  ) : (
                    <span class="badge-vendor">数据来源：官方标称/历史存档</span>
                  )}
                </div>

                {brand.speedImage ? (
                  <div class="speedtest-showcase">
                    <p class="speedtest-intro">
                      以下为本站在特定测试宽带环境下针对 <strong>{brand.name}</strong> 节点跑出的实时并发带宽与握手延迟测速快照：
                    </p>
                    <div class="speedtest-img-container">
                      <a href={brand.speedImage} target="_blank" title="点击查看高清测速原图">
                        <img
                          src={brand.speedImage}
                          alt={`${brand.name} 节点测速实测报告图`}
                          loading="lazy"
                          decoding="async"
                          class="speed-img"
                        />
                      </a>
                    </div>
                    <p class="img-caption">
                      * 提示：点击图片可查看高分辨率原始测速图。测速工具：MAI-TEST-BOT / 联通千兆环境。
                    </p>
                  </div>
                ) : null}

                {brand.speedTable && brand.speedTable.length > 0 ? (
                  <div class="table-responsive">
                    <table class="data-table">
                      <thead>
                        <tr>
                          <th>测试节点 / 地区</th>
                          <th>握手延迟 (Latency)</th>
                          <th>峰值下载速率 (Speed)</th>
                        </tr>
                      </thead>
                      <tbody>
                        {brand.speedTable.map((row) => (
                          <tr>
                            <td><strong>{row.node}</strong></td>
                            <td><span class="latency-val">{row.latency}</span></td>
                            <td><span class="speed-val">{row.download}</span></td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                ) : (
                  !brand.speedImage && (
                    <p class="note-box">
                      该品牌暂未录入单节点速度快照，实际速率以您本地宽带（电信/联通/移动）到落地节点的路由情况为准。
                    </p>
                  )
                )}
              </section>

              {/* Streaming & AI Unlocks */}
              <section class="card-section rev rev-d1" id="unlocks">
                <h2 class="d3">🎬 流媒体与 AI 工具解锁矩阵</h2>
                <p class="section-sub">
                  根据真实节点测试与用户反馈归纳，以下为常用海外流媒体及主流人工智能服务在 <strong>{brand.name}</strong> 节点下的解锁表现：
                </p>

                <div class="unlock-grid">
                  <div class:list={['unlock-box', brand.unlocks.chatgpt]}>
                    <span class="u-name">ChatGPT (OpenAI)</span>
                    <span class="u-status">
                      {brand.unlocks.chatgpt === 'supported' ? '✅ 原生支持' : '⚠️ 视节点而定'}
                    </span>
                  </div>
                  <div class:list={['unlock-box', brand.unlocks.claude]}>
                    <span class="u-name">Claude (Anthropic)</span>
                    <span class="u-status">
                      {brand.unlocks.claude === 'supported' ? '✅ 原生支持' : '⚠️ 视节点而定'}
                    </span>
                  </div>
                  <div class:list={['unlock-box', brand.unlocks.netflix]}>
                    <span class="u-name">Netflix (网飞)</span>
                    <span class="u-status">
                      {brand.unlocks.netflix === 'supported' ? '✅ 全区解锁' : '⚠️ 视节点而定'}
                    </span>
                  </div>
                  <div class:list={['unlock-box', brand.unlocks.youtube]}>
                    <span class="u-name">YouTube 4K</span>
                    <span class="u-status">✅ 秒开流畅</span>
                  </div>
                  <div class:list={['unlock-box', brand.unlocks.disney]}>
                    <span class="u-name">Disney+</span>
                    <span class="u-status">
                      {brand.unlocks.disney === 'supported' ? '✅ 完整解锁' : '⚠️ 视节点而定'}
                    </span>
                  </div>
                  <div class:list={['unlock-box', brand.unlocks.tiktok]}>
                    <span class="u-name">TikTok / 跨境业务</span>
                    <span class="u-status">
                      {brand.unlocks.tiktok === 'supported' ? '✅ 支持' : '⚠️ 需原生节点'}
                    </span>
                  </div>
                </div>

                {/* Unlock Screenshots if any (e.g. 光速云) */}
                {brand.unlockImages && brand.unlockImages.length > 0 && (
                  <div class="unlock-gallery-wrap">
                    <h3 class="d4">📸 流媒体与 ChatGPT 原生解锁测试截图存证</h3>
                    <div class="unlock-gallery">
                      {brand.unlockImages.slice(0, 4).map((imgUrl, uIdx) => (
                        <a href={imgUrl} target="_blank" class="unlock-thumb-link" title="点击查看解锁全图">
                          <img src={imgUrl} alt={`${brand.name} 流媒体与AI解锁实测截图 ${uIdx + 1}`} loading="lazy" />
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </section>

              {/* Pricing & Plans Table */}
              {brand.plans && brand.plans.length > 0 && (
                <section class="card-section rev rev-d1" id="plans">
                  <h2 class="d3">💰 套餐规格与资费对照表</h2>
                  <p class="section-sub">
                    以下为 <strong>{brand.name}</strong> 官方公布的核心套餐明细（未计算限时优惠码折扣）：
                  </p>

                  <div class="table-responsive">
                    <table class="data-table">
                      <thead>
                        <tr>
                          <th>套餐名称</th>
                          <th>计费周期</th>
                          <th>套餐价格</th>
                          <th>流量配额</th>
                          <th>周期说明</th>
                        </tr>
                      </thead>
                      <tbody>
                        {brand.plans.map((p) => (
                          <tr>
                            <td><strong>{p.name}</strong></td>
                            <td><span class="cycle-pill">{p.billing}</span></td>
                            <td><strong class="price-val">{p.price}</strong></td>
                            <td>{p.traffic}</td>
                            <td class="text-muted">{p.cycle}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </section>
              )}

              {/* Pros and Cons */}
              <section class="card-section rev" id="pros-cons">
                <h2 class="d3">⚖️ 核心优势与限制说明</h2>
                <div class="pros-cons-grid">
                  <div class="pros-box">
                    <h3 class="pros-title">🌟 核心亮点</h3>
                    <ul>
                      {brand.strengths.map((s) => (
                        <li>
                          <Icon name="check" class="ic-xs check-green" />
                          <span>{s}</span>
                        </li>
                      ))}
                      <li>
                        <Icon name="check" class="ic-xs check-green" />
                        <span>线路架构：{brand.lineType.join(' + ')}</span>
                      </li>
                      {brand.hasCustomClient && (
                        <li>
                          <Icon name="check" class="ic-xs check-green" />
                          <span>提供专属自研客户端，免去繁琐订阅转换与规则配置</span>
                        </li>
                      )}
                    </ul>
                  </div>

                  <div class="cons-box">
                    <h3 class="cons-title">⚠️ 注意事项与边界</h3>
                    <ul>
                      {brand.limitations.map((lim) => (
                        <li>
                          <Icon name="close" class="ic-xs close-red" />
                          <span>{lim}</span>
                        </li>
                      ))}
                      <li>
                        <Icon name="close" class="ic-xs close-red" />
                        <span>跨境网络不可抗力因素较多，新用户强烈建议先月付体验</span>
                      </li>
                    </ul>
                  </div>
                </div>
              </section>

              {/* FAQ Section */}
              <section class="card-section rev" id="faq">
                <h2 class="d3">❓ 常见问题与答疑 (FAQ)</h2>
                <div class="brand-faq-list">
                  <details class="brand-faq-item" open>
                    <summary class="faq-summary">
                      <span>{brand.name} 适合哪些人群选择？</span>
                      <Icon name="plus" class="ic-xs" />
                    </summary>
                    <div class="faq-content">
                      <p>
                        {brand.name} 适合看重 <strong>{brand.lineType[0]}</strong> 晚高峰低延迟、需要流畅播放 4K 视频、访问海外科研资料或轻度 AI 办公的用户。
                        {brand.hasCustomClient ? '由于具备自研客户端，也是完全不想折腾规则导入的小白用户的良好选择。' : '对于极客用户，可将订阅链接直接导入 Clash Verge Rev 或 Shadowrocket 自由编写分流。'}
                      </p>
                    </div>
                  </details>

                  <details class="brand-faq-item">
                    <summary class="faq-summary">
                      <span>如何获取 {brand.name} 的最新可用优惠码？</span>
                      <Icon name="plus" class="ic-xs" />
                    </summary>
                    <div class="faq-content">
                      <p>
                        {brand.discountCode ? (
                          <>
                            本站已为您整理 {brand.name} 官方可用优惠码：<code>{brand.discountCode}</code>。您可以在本页点击“复制优惠码”，在官网结账页面粘贴即可立享折扣。
                          </>
                        ) : (
                          '该品牌目前暂无长期通用优惠码。建议您直接在官网查看是否有阶段性新人促销或年付折算活动。'
                        )}
                      </p>
                    </div>
                  </details>

                  <details class="brand-faq-item">
                    <summary class="faq-summary">
                      <span>购买后无法连接或订阅导入失败怎么办？</span>
                      <Icon name="plus" class="ic-xs" />
                    </summary>
                    <div class="faq-content">
                      <p>
                        1. 检查本地电脑/手机系统时间是否精准同步（时间偏差超过 60 秒会导致 VLESS/Trojan 握手失败）；<br />
                        2. 在官网用户后台刷新订阅令牌，重新拷贝通用订阅链接；<br />
                        3. 如仍有问题，可登录官网工单中心联系官方 7×24 小时技术客服协助。
                      </p>
                    </div>
                  </details>
                </div>
              </section>
            </div>
          )}
        </div>

        <!-- Sidebar Sticky Column -->
        <aside class="brand-sidebar-col rev rev-d2">
          <div class="sidebar-card">
            <h3 class="sc-title">速览与决策指引</h3>
            <div class="sc-meta-list">
              <div class="sc-meta-item">
                <span class="k">综合排名</span>
                <span class="v rank-badge">TOP {brand.rank}</span>
              </div>
              <div class="sc-meta-item">
                <span class="k">最低起步</span>
                <span class="v price-highlight">{brand.pricingMin}</span>
              </div>
              <div class="sc-meta-item">
                <span class="k">专线类型</span>
                <span class="v">{brand.lineType[0]}</span>
              </div>
              <div class="sc-meta-item">
                <span class="k">自研客户端</span>
                <span class="v">{brand.hasCustomClient ? '✅ 包含' : '❌ 需第三方'}</span>
              </div>
              <div class="sc-meta-item">
                <span class="k">流媒体解锁</span>
                <span class="v">全主流平台</span>
              </div>
            </div>

            {brand.affUrl && (
              <div class="sc-btn-wrap">
                <a
                  href={brand.affUrl}
                  target="_blank"
                  rel="nofollow sponsored noopener"
                  class="btn btn-lime btn-full"
                >
                  <span>直达 {brand.name} 官网</span>
                  <Icon name="arrow" class="ic-xs" />
                </a>
                <p class="sc-disclaimer">
                  * 本站赞助推广链接，不影响用户价格与权益
                </p>
              </div>
            )}
          </div>

          <!-- Quick Jump -->
          {isGuangsu ? (
            <div class="sidebar-card nav-card sticky-toc-card">
              <h4 class="nav-title">📖 本书目录（点击直达章节）</h4>
              <ul class="quick-nav-list monograph-toc">
                {guangsuReviewDossier.chapters.map((ch, idx) => (
                  <li>
                    <a href={`#${ch.anchor}`} class="toc-link">
                      <span class="toc-num">{idx + 1}.</span>
                      <span class="toc-txt">{ch.navTitle}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <div class="sidebar-card nav-card">
              <h4 class="nav-title">本篇评测导航</h4>
              <ul class="quick-nav-list">
                <li><a href="#speedtest">节点测速实测报告</a></li>
                <li><a href="#unlocks">流媒体与AI解锁状态</a></li>
                <li><a href="#plans">套餐规格与价格对照</a></li>
                <li><a href="#pros-cons">核心优势与局限说明</a></li>
                <li><a href="#faq">常见问题与避坑解答</a></li>
              </ul>
            </div>
          )}

          <!-- Related Guides Backlink Card -->
          <div class="sidebar-card guides-nav-card">
            <h4 class="nav-title">选型与避坑攻略</h4>
            <ul class="quick-nav-list">
              <li><a href="/guides/decision-tree/">🎯 2026 选型决策树</a></li>
              <li><a href="/guides/iepl-vs-iplc-vs-bgp/">⚡ IEPL 专线深度解析</a></li>
              <li><a href="/guides/airport-anti-scam/">🛡️ 新手避坑防跑路法则</a></li>
              <li><a href="/guides/chatgpt-streaming-unlock/">🎬 ChatGPT与流媒体解锁</a></li>
              <li><a href="/guides/client-setup-rules/">📱 客户端分流实操教程</a></li>
            </ul>
          </div>
        </aside>
      </div>

      <!-- Next and Prev Brand Pagination -->
