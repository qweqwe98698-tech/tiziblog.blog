---
/**
 * Standard inner page: a header block with eyebrow, title and intro,
 * followed by whatever the page puts in the default slot.
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  /** Visible page heading. Falls back to `title`. */
  heading?: string;
  intro?: string;
  crumbs?: { label: string; href?: string }[];
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  jsonLd?: string;
  /** Set false to render your own header block in the slot. */
  showHeader?: boolean;
}

const {
  title,
  description,
  eyebrow,
  heading,
  intro,
  crumbs,
  showHeader = true,
  ...seo
} = Astro.props;
---

<BaseLayout title={title} description={description} {...seo}>
  {
    showHeader && (
      <section class="wrap phero">
        <div class="phero-in rev">
          {crumbs && <Breadcrumbs items={crumbs} />}
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          <h1 class="d1" style="font-size:clamp(32px,4.5vw,56px);line-height:1.2;text-wrap:balance;word-break:keep-all;" set:html={heading ?? title} />
          {intro && <p class="lead">{intro}</p>}
          <slot name="header-extra" />
        </div>
      </section>
    )
  }
  <slot />
</BaseLayout>
